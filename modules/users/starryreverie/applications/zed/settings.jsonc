{
  // General
  "cli_default_open_behavior": "new_window",
  "close_panel_on_toggle": true,
  "restore_on_startup": "launchpad",
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine Moon"
  },

  // Editor
  "auto_signature_help": true,
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": false
  },
  "search": {
    "regex": true
  },
  "use_smartcase_search": true,
  "vertical_scroll_margin": 5.0,

  // Fonts
  "buffer_font_family": "Maple Mono NL NF CN",
  "buffer_line_height": "comfortable",
  "buffer_font_size": 12.0,
  "ui_font_family": "Noto Sans",
  "ui_font_size": 14.0,
  "markdown_preview": {
    "font_size": 14.0,
    "heading_font_weight": 700.0
  },

  // Keymapping
  "helix_mode": true,
  "base_keymap": "VSCode",
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "never"
  },

  // Windows and Panels
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "gutter": {
    "min_line_number_digits": 3,
    "folds": false,
    "runnables": true,
    "breakpoints": true,
    "bookmarks": true,
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "project_panel": {
    "sticky_scroll": false,
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "comfortable"
  },
  "status_bar": {
    "line_endings_button": true
  },
  "terminal": {
    "cursor_shape": "underline",
    "bell": "system",
    "font_size": 12.0,
    "blinking": "on"
  },
  "title_bar": {
    "show_sign_in": false
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": false
  },
  "window_title_separator": " - ",

  // No AI and Proprietary Services
  "show_edit_predictions": false,
  "agent": {
    "button": false,
    "model_parameters": []
  },
  "auto_update": false,
  "collaboration_panel": {
    "button": false
  },
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
